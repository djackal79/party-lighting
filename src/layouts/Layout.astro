---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} description={description} />
	</head>
	<body>
		<slot />
	</body>
</html>
