---
import Layout from '../layouts/Layout.astro';
import servicesData from '../data/services.json';
import galleryData from '../data/gallery.json';

const title = "Event Lighting Sydney | {{LIGHTING_DOMAIN}}";
const description = "Professional event lighting and production for weddings, parties, and corporate events in Sydney and surrounds. Reliable rigging and competent execution.";
---

<Layout title={title} description={description}>
  
  <section class="hero">
    <div class="ambient-gels" aria-hidden="true">
      <div class="gel gel-1"></div>
      <div class="gel gel-2"></div>
      <div class="gel gel-3"></div>
    </div>
    
    <div class="container hero-content">
      <header>
        <h1>Lighting changes everything.</h1>
        <p class="subtitle">Competent execution and reliable rigging for events across Sydney.</p>
      </header>
      <div class="cta-group">
        <a href="#gallery" class="btn btn-outline">See the work</a>
        <a href="#quote" class="btn btn-primary">Get a quote</a>
      </div>
    </div>
  </section>

  <section id="services" class="section services-section">
    <div class="container">
      <h2>What's Offered</h2>
      <div class="services-grid">
        {servicesData.map((service) => (
          <div class="service-card" key={service.id}>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="gallery" class="section gallery-section">
    <div class="container">
      <h2>In Action</h2>
      {galleryData.length === 0 ? (
        <div class="empty-state">
          <p>No gallery images yet. Check back soon for photos of our recent setups.</p>
        </div>
      ) : (
        <div class="gallery-grid">
          {galleryData.map((item, idx) => (
            <figure class="gallery-item" key={idx}>
              <img src={item.src} alt={item.alt} loading="lazy" />
              <figcaption>
                <span class="caption">{item.caption}</span>
                {item.venue && <span class="venue">{item.venue}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section id="logistics" class="section logistics-section">
    <div class="container">
      <h2>Coverage & Logistics</h2>
      <div class="logistics-grid">
        <div class="logistic-item">
          <h3>Service Area</h3>
          <p>{"{{ }}"}</p>
        </div>
        <div class="logistic-item">
          <h3>Setup & Pack-down</h3>
          <p>{"{{ }}"}</p>
        </div>
        <div class="logistic-item">
          <h3>Power Requirements</h3>
          <p>{"{{ }}"}</p>
        </div>
        <div class="logistic-item">
          <h3>Venue Access</h3>
          <p>{"{{ }}"}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="section pricing-section">
    <div class="container">
      <div class="pricing-card">
        <h2>Pricing Signal</h2>
        <p class="price-figure">{"{{ }}"}</p>
        <p class="price-note">All events are custom-quoted based on venue size, logistics, and design requirements.</p>
      </div>
    </div>
  </section>

  <section id="quote" class="section form-section">
    <div class="container form-container">
      <h2>Get a Quote</h2>
      <form id="enquiry-form" class="enquiry-form">
        <input type="hidden" name="source" value="lighting" />
        <input type="text" name="honeypot" class="visually-hidden" tabindex="-1" autocomplete="off" />
        
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>
        
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        
        <div class="form-group">
          <label for="date">Event Date</label>
          <input type="date" id="date" name="date" required />
        </div>
        
        <div class="form-group">
          <label for="venue">Venue or Suburb</label>
          <input type="text" id="venue" name="venue" required />
        </div>
        
        <div class="form-group">
          <label for="message">Details</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        
        <button type="submit" class="btn btn-primary submit-btn">Send Enquiry</button>
        <div id="form-status" class="form-status" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} {"{{LIGHTING_DOMAIN}}"}.</p>
      <nav>
        <a href="/privacy">Privacy Policy</a>
      </nav>
    </div>
  </footer>
</Layout>

<script>
  const form = document.getElementById('enquiry-form');
  const statusDiv = document.getElementById('form-status');

  if (form && statusDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const btn = form.querySelector('.submit-btn');
      if(btn) btn.setAttribute('disabled', 'true');
      statusDiv.innerHTML = 'Sending...';
      statusDiv.className = 'form-status sending';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      if (data.honeypot) {
        // Silently succeed for bots
        statusDiv.innerHTML = 'Enquiry sent.';
        statusDiv.className = 'form-status success';
        return;
      }

      try {
        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          statusDiv.innerHTML = 'Thank you. Your enquiry has been received and we will be in touch shortly.';
          statusDiv.className = 'form-status success';
          form.reset();
        } else {
          throw new Error('Server returned an error');
        }
      } catch (err) {
        statusDiv.innerHTML = 'Something went wrong submitting your form. Please email us directly at <a href="mailto:hello@{{LIGHTING_DOMAIN}}">hello@{{LIGHTING_DOMAIN}}</a>.';
        statusDiv.className = 'form-status error';
      } finally {
        if(btn) btn.removeAttribute('disabled');
      }
    });
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 800px;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: #fff;
  }
  
  .hero .subtitle {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--text-muted);
    max-width: 600px;
    margin-bottom: 3rem;
  }

  /* Ambient Gels */
  .ambient-gels {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #0a0a0f 0%, var(--bg-deep) 100%);
  }
  
  .gel {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.6;
    mix-blend-mode: screen;
  }

  .gel-1 {
    width: 60vw;
    height: 60vw;
    background: var(--gel-ct-blue);
    top: -10%;
    left: -10%;
    animation: drift 20s infinite alternate ease-in-out;
  }

  .gel-2 {
    width: 50vw;
    height: 50vw;
    background: var(--gel-bastard-amber);
    bottom: -20%;
    right: -10%;
    animation: drift 25s infinite alternate-reverse ease-in-out;
  }

  .gel-3 {
    width: 40vw;
    height: 40vw;
    background: var(--gel-congo-blue);
    top: 30%;
    left: 40%;
    animation: pulse 15s infinite alternate ease-in-out;
    opacity: 0.4;
  }

  @keyframes drift {
    0% { transform: translate(0, 0); }
    100% { transform: translate(10%, 10%); }
  }
  
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.3; }
    100% { transform: scale(1.2); opacity: 0.6; }
  }

  /* Buttons */
  .cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .btn {
    display: inline-flex;
    padding: 0.875rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
    font-family: var(--font-sans);
  }
  
  .btn-primary {
    background: #fff;
    color: var(--bg-deep);
  }
  .btn-primary:hover, .btn-primary:focus-visible {
    background: var(--gel-bastard-amber);
  }
  
  .btn-outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
  }
  .btn-outline:hover, .btn-outline:focus-visible {
    border-color: #fff;
    background: rgba(255,255,255,0.05);
  }

  /* Sections */
  .section {
    padding: 6rem 0;
  }
  .section h2 {
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: #fff;
  }

  /* Services */
  .services-section {
    background: var(--bg-surface);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  .service-card {
    background: var(--bg-deep);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .service-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--gel-bastard-amber);
  }
  .service-card p {
    color: var(--text-muted);
  }

  /* Gallery */
  .gallery-section {
    background: var(--bg-deep);
  }
  .empty-state {
    padding: 4rem;
    text-align: center;
    border: 1px dashed rgba(255,255,255,0.2);
    border-radius: 8px;
    color: var(--text-muted);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .gallery-item {
    margin: 0;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #111;
    aspect-ratio: 4/3;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .gallery-item:hover img {
    transform: scale(1.05);
  }
  .gallery-item figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1.5rem 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .gallery-item .caption {
    font-weight: 600;
    color: #fff;
  }
  .gallery-item .venue {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Logistics */
  .logistics-section {
    background: var(--bg-surface);
  }
  .logistics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }
  .logistic-item h3 {
    color: var(--gel-ct-blue);
    margin-bottom: 1rem;
  }
  .logistic-item p {
    color: var(--text-muted);
  }

  /* Pricing */
  .pricing-section {
    background: var(--bg-deep);
    text-align: center;
  }
  .pricing-card {
    max-width: 600px;
    margin: 0 auto;
    padding: 4rem 2rem;
    background: linear-gradient(145deg, var(--bg-surface), #0a0a0d);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .price-figure {
    font-size: 3.5rem;
    font-weight: 600;
    color: var(--gel-magenta);
    margin: 1.5rem 0;
  }
  .price-note {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  /* Form */
  .form-section {
    background: var(--bg-surface);
  }
  .form-container {
    max-width: 600px;
  }
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    border: 0;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  label {
    font-weight: 600;
    color: #fff;
  }
  input, textarea {
    width: 100%;
    padding: 1rem;
    background: var(--bg-deep);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    border-radius: 4px;
    font-family: inherit;
    transition: border-color 0.2s ease;
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--gel-ct-blue);
  }
  .form-status {
    padding: 1rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .form-status.sending {
    color: var(--text-muted);
  }
  .form-status.success {
    background: rgba(46, 204, 113, 0.1);
    color: #2ecc71;
  }
  .form-status.error {
    background: rgba(231, 76, 60, 0.1);
    color: #e74c3c;
  }
  .form-status.error a {
    text-decoration: underline;
  }
  
  /* Footer */
  .site-footer {
    background: #000;
    padding: 3rem 0;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .site-footer p {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .site-footer nav a {
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: underline;
  }
  .site-footer nav a:hover {
    color: #fff;
  }
</style>
